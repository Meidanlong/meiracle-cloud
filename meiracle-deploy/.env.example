# ============================================================================
# meiracle-cloud 中间件部署 · 环境变量样例
# ----------------------------------------------------------------------------
# 复制本文件为 .env 后再启动：  cp .env.example .env
# 请将下方所有 CHANGE_ME_* 替换为真实强密码（不要提交真实 .env 到仓库）。
# 所有默认值仅为占位，禁止在生产环境直接使用。
# ============================================================================

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
MYSQL_DATABASE=meiracle
MYSQL_USER=meiracle
MYSQL_PASSWORD=CHANGE_ME_db_pwd
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_redis_pwd
REDIS_PORT=6379

# ---------- Nacos ----------
NACOS_PORT=8848
NACOS_AUTH_IDENTITY_KEY=CHANGE_ME_nacos_identity_key
NACOS_AUTH_IDENTITY_VALUE=CHANGE_ME_nacos_identity_value
NACOS_AUTH_TOKEN=CHANGE_ME_nacos_auth_token

# ---------- MinIO ----------
MINIO_ROOT_USER=CHANGE_ME_minio_access
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Nexus (Maven 私服，可选) ----------
NEXUS_PORT=8081
NEXUS_ADMIN_PASSWORD=CHANGE_ME_nexus_admin

# ---------- Seata (分布式事务，可选) ----------
SEATA_PORT=8091
SEATA_CONSOLE_PORT=7091
SEATA_TOKEN=CHANGE_ME_seata_token

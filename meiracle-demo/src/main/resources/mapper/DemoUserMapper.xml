<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.meiracle.demo.dao.mapper.DemoUserMapper">

    <!-- 示例：XML 方式的 SQL（与注解/BaseMapperPlus 并存的第三种写法演示） -->
    <select id="selectByIdXml" resultType="cn.meiracle.demo.domain.DemoUser">
        SELECT id, name, email, create_time, update_time
        FROM demo_user
        WHERE id = #{id}
    </select>

</mapper>

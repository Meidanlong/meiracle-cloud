<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>cn.meiracle</groupId>
    <artifactId>meiracle-agent</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>meiracle-agent</name>
    <description>Agent 知识库 / RAG 对话能力（基于 aizuda SnailAI 服务端 starter，cn.meiracle.agent 包，独立模块；向量库可运行时选 Elasticsearch / PostgreSQL / Milvus）</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- SnailAI 服务端 starter 版本（aizuda 官方，外部 SDK，保留 com.aizuda 坐标） -->
        <snailai.version>1.1.1</snailai.version>
        <elasticsearch.version>9.4.2</elasticsearch.version>
    </properties>

    <dependencies>
        <!-- meiracle 公共能力：Nacos 客户端（注册/配置接入） -->
        <dependency>
            <groupId>cn.meiracle</groupId>
            <artifactId>nacos</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- SnailAI 服务端（Agent 知识库 / RAG 对话核心能力，aizuda 官方 starter） -->
        <dependency>
            <groupId>com.aizuda</groupId>
            <artifactId>snail-ai-starter</artifactId>
            <version>${snailai.version}</version>
        </dependency>

        <!-- 向量检索客户端：启用 Elasticsearch 作为向量库后端时使用（向量库实例在管理后台运行时配置） -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-rest5-client</artifactId>
            <version>${elasticsearch.version}</version>
        </dependency>
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
            <version>${elasticsearch.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 知识库/对话元数据存储（snail-ai 自带 storage starter 需要数据源驱动） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>cn.meiracle.agent.MeiracleAgentApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <configuration>
                            <!-- 默认 artifact 保持为普通库 jar；可执行 fat jar 以 -exec 分类器产出，仅用于独立启动。 -->
                            <classifier>exec</classifier>
                        </configuration>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
